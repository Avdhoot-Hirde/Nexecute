# URL of the Nexecute Spring API. Do not place secrets in VITE_* variables.
VITE_API_BASE_URL=http://localhost:8080

# JWT authentication endpoints
VITE_AUTH_LOGIN_PATH=/api/auth/login
VITE_AUTH_REGISTER_PATH=/api/auth/register
VITE_AUTH_ME_PATH=/api/auth/me
VITE_AUTH_LOGOUT_PATH=/api/auth/logout
VITE_AUTH_REFRESH_PATH=/api/auth/refresh

# Spring Security OAuth2 authorization endpoint
VITE_GITHUB_OAUTH_PATH=/oauth2/authorization/github

# Sandboxed code execution endpoint
VITE_EXECUTE_PATH=/api/trial/execute

# Optional IDE integrations
VITE_IDE_HISTORY_PATH=/api/history
VITE_GITHUB_PUSH_PATH=/api/github/push
# VITE_IDE_WEBSOCKET_URL=ws://localhost:8080/ws/ide
